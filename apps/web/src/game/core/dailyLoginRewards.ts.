
import type { ItemId } from "@xmoonverse/shared";
import { getItemById } from "./items";

export interface DailyLoginReward {
  day: number;
  gold: number;
  gems: number;
  items: {
    itemId: ItemId;
    quantity: number;
  }[];
}

export interface LoginRewardState {
  lastClaimDate: string | null;
  currentStreak: number;
  totalClaims: number;
}

export interface LoginRewardResult {
  state: LoginRewardState;
  reward: DailyLoginReward;
}

export const DAILY_LOGIN_REWARDS: DailyLoginReward[] = [
  {
    day: 1,
    gold: 100,
    gems: 0,
    items: []
  },
  {
    day: 2,
    gold: 150,
    gems: 0,
    items: []
  },
  {
    day: 3,
    gold: 200,
    gems: 1,
    items: [
      {
        itemId: "small_health_potion",
        quantity: 1
      }
    ]
  },
  {
    day: 4,
    gold: 250,
    gems: 0,
    items: []
  },
  {
    day: 5,
    gold: 300,
    gems: 2,
    items: [
      {
        itemId: "small_health_potion",
        quantity: 2
      }
    ]
  },
  {
    day: 6,
    gold: 400,
    gems: 0,
    items: []
  },
  {
    day: 7,
    gold: 500,
    gems: 5,
    items: [
      {
        itemId: "moon_crystal",
        quantity: 1
      }
    ]
  }
];

function isValidNonNegativeInteger(
  value: unknown
): value is number {
  return (
    typeof value === "number" &&
    Number.isSafeInteger(value) &&
    value >= 0
  );
}

function isValidLoginDate(
  value: unknown
): value is string {
  if (
    typeof value !== "string" ||
    !/^\d{4}-\d{2}-\d{2}$/.test(value)
  ) {
    return false;
  }

  const date = new Date(`${value}T00:00:00.000Z`);

  return (
    Number.isFinite(date.getTime()) &&
    date.toISOString().slice(0, 10) === value
  );
}

function validateLoginRewardCatalog(): void {
  if (
    !Array.isArray(DAILY_LOGIN_REWARDS) ||
    DAILY_LOGIN_REWARDS.length === 0
  ) {
    throw new Error("Invalid daily login reward catalog");
  }

  const days = new Set<number>();

  for (const reward of DAILY_LOGIN_REWARDS) {
    if (
      typeof reward !== "object" ||
      reward === null ||
      !Number.isSafeInteger(reward.day) ||
      reward.day <= 0 ||
      days.has(reward.day) ||
      !isValidNonNegativeInteger(reward.gold) ||
      !isValidNonNegativeInteger(reward.gems) ||
      !Array.isArray(reward.items)
    ) {
      throw new Error("Invalid daily login reward definition");
    }

    days.add(reward.day);

    const rewardedItems = new Set<ItemId>();

    for (const item of reward.items) {
      if (
        typeof item !== "object" ||
        item === null ||
        typeof item.itemId !== "string" ||
        !getItemById(item.itemId) ||
        !Number.isSafeInteger(item.quantity) ||
        item.quantity <= 0 ||
        rewardedItems.has(item.itemId)
      ) {
        throw new Error("Invalid daily login reward item");
      }

      rewardedItems.add(item.itemId);
    }
  }

  for (let day = 1; day <= DAILY_LOGIN_REWARDS.length; day += 1) {
    if (!days.has(day)) {
      throw new Error("Daily login reward days must be sequential");
    }
  }
}

function validateLoginRewardState(
  state: LoginRewardState
): void {
  if (
    typeof state !== "object" ||
    state === null ||
    !isValidNonNegativeInteger(state.currentStreak) ||
    !isValidNonNegativeInteger(state.totalClaims) ||
    (
      state.lastClaimDate !== null &&
      !isValidLoginDate(state.lastClaimDate)
    )
  ) {
    throw new Error("Invalid login reward state");
  }

  if (
    state.lastClaimDate === null &&
    state.currentStreak !== 0
  ) {
    throw new Error("Invalid login streak without a claim date");
  }
}

export function createLoginRewardState(): LoginRewardState {
  return {
    lastClaimDate: null,
    currentStreak: 0,
    totalClaims: 0
  };
}

export function getLoginDateKey(timestamp: number): string {
  if (
    !Number.isFinite(timestamp) ||
    Math.abs(timestamp) > 8640000000000000
  ) {
    throw new Error("Invalid timestamp");
  }

  const date = new Date(timestamp);

  if (!Number.isFinite(date.getTime())) {
    throw new Error("Invalid timestamp");
  }

  return date.toISOString().slice(0, 10);
}

function getDateDifference(
  previousDate: string,
  currentDate: string
): number {
  if (
    !isValidLoginDate(previousDate) ||
    !isValidLoginDate(currentDate)
  ) {
    throw new Error("Invalid login date");
  }

  const previous = new Date(
    `${previousDate}T00:00:00.000Z`
  );

  const current = new Date(
    `${currentDate}T00:00:00.000Z`
  );

  return (
    current.getTime() - previous.getTime()
  ) / 86400000;
}

export function claimDailyLoginReward(
  state: LoginRewardState,
  timestamp: number = Date.now()
): LoginRewardResult {
  validateLoginRewardState(state);
  validateLoginRewardCatalog();

  const currentDate = getLoginDateKey(timestamp);

  let nextStreak = 1;

  if (state.lastClaimDate !== null) {
    const difference = getDateDifference(
      state.lastClaimDate,
      currentDate
    );

    if (difference < 0) {
      throw new Error("Login date cannot move backwards");
    }

    if (difference === 0) {
      throw new Error("Daily reward already claimed");
    }

    nextStreak =
      difference === 1
        ? state.currentStreak + 1
        : 1;
  }

  if (
    !Number.isSafeInteger(nextStreak) ||
    !Number.isSafeInteger(state.totalClaims + 1)
  ) {
    throw new Error("Login reward state overflow");
  }

  const rewardDay =
    ((nextStreak - 1) % DAILY_LOGIN_REWARDS.length) + 1;

  const reward = DAILY_LOGIN_REWARDS.find(
    (entry) => entry.day === rewardDay
  );

  if (!reward) {
    throw new Error("Daily login reward not found");
  }

  return {
    state: {
      lastClaimDate: currentDate,
      currentStreak: nextStreak,
      totalClaims: state.totalClaims + 1
    },
    reward: {
      ...reward,
      items: reward.items.map((item) => ({
        ...item
      }))
    }
  };
}
